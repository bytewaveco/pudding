{
  "name": "@bytewaveco/pudding",
  "version": "0.1.0-beta.6",
  "description": "Prove laws about existing TypeScript functions, with Lean doing the checking",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytewaveco/pudding.git"
  },
  "homepage": "https://github.com/bytewaveco/pudding#readme",
  "bugs": "https://github.com/bytewaveco/pudding/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pudding": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/index.d.ts",
    "dist/runner.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --removeComments --declaration false && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "proof": "npm run build --silent && node dist/cli.js",
    "test": "npm run build --silent && node --test test/*.test.ts",
    "prepack": "npm run build --silent",
    "test:package": "npm run build --silent && node scripts/smoke-package.mjs",
    "fuzz": "npm run build --silent && node scripts/fuzz.mjs",
    "pack:runtime": "npm run build --silent && node scripts/pack-runtime.mjs"
  },
  "peerDependencies": {
    "tsrs": "*",
    "typescript": ">=7.0.2 || >=7.1.0-0",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "tsrs": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "typescript",
    "proof",
    "lean",
    "verification",
    "laws",
    "property",
    "testing"
  ],
  "optionalDependencies": {
    "@bytewaveco/pudding-lean-darwin-arm64": "4.36.0",
    "@bytewaveco/pudding-lean-darwin-x64": "4.36.0",
    "@bytewaveco/pudding-lean-linux-arm64": "4.36.0",
    "@bytewaveco/pudding-lean-linux-x64": "4.36.0"
  }
}
