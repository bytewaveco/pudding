{
  "name": "@bytewaveco/pudding",
  "version": "0.1.0-beta.0",
  "description": "Prove laws about existing TypeScript functions, with Lean doing the checking",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pudding": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "proof": "npm run build --silent && node dist/cli.js",
    "test": "npm run build --silent && node --test test/*.test.ts",
    "prepack": "npm run build --silent",
    "test:package": "npm run build --silent && node scripts/smoke-package.mjs",
    "fuzz": "npm run build --silent && node scripts/fuzz.mjs"
  },
  "dependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "keywords": [
    "typescript",
    "proof",
    "lean",
    "verification",
    "laws",
    "property",
    "testing"
  ]
}
