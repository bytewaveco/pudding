{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "test/**/*.ts", "pudding.config.ts"],
  "exclude": ["test/fixtures/typeerror", "test/fixtures/.tmp-*", "test/fixtures/review-*"]
}
